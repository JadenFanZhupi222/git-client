{
  "name": "app",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "overrides": {
      "@wdio/native-utils": "2.5.0"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node ../scripts/check-bundle-size.mjs dist 500000",
    "build:e2e": "tsc && vite build --mode e2e && node ../scripts/check-bundle-size.mjs dist 500000",
    "test": "vitest run",
    "e2e": "wdio run ./wdio.conf.js",
    "e2e:build": "tauri build --ci --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e:ci": "pnpm e2e:build && pnpm e2e",
    "release:check": "node ../scripts/release-preflight.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/merge": "^6.12.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/native-utils": "2.5.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  }
}
