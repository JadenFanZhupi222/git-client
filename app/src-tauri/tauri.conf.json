{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Client",
  "version": "0.1.0",
  "identifier": "com.gitclient.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Client",
        "width": 1240,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "local-development-placeholder",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
